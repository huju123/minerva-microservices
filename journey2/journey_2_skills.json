  "current_skill_profile_logic": {
    "purpose": "Convert the five career-specific assessment answers into a diagnostic current-skill profile without changing the overall readiness score.",
    "step_1": "Score the five questions using assessment.json.",
    "step_2": "For every correctly answered question, mark all skills in that question's question_skill_mapping as demonstrated.",
    "step_3": "For every incorrectly answered question, mark those mapped skills as needing development evidence.",
    "step_4": "Aggregate evidence for each skill. A skill can receive multiple positive or negative signals when it appears in multiple questions.",
    "step_5": "Convert the evidence into a 1-5 skill level using the skill_level_calculation rules below.",
    "step_6": "Compare the resulting current level with each skill's target_level.",
    "step_7": "Generate strengths from skills at or above target_level.",
    "step_8": "Generate weaknesses from skills below target_level.",
    "step_9": "Generate priority from the size of the gap and the skill category.",
    "step_10": "Return the current skill profile together with readiness; do not expose correct answers."
  },
  "skill_level_calculation": {
    "question_signal_weight": 1,
    "positive_signal": "correct answer on a question mapped to the skill",
    "negative_signal": "incorrect answer on a question mapped to the skill",
    "mapping_rule": "Because each career has five questions and skills may appear in one or more question mappings, calculate evidence as positive_signals / total_signals for that skill.",
    "conversion": [
      {
        "evidence_min": 0.0,
        "evidence_max": 0.19,
        "level": 1
      },
      {
        "evidence_min": 0.2,
        "evidence_max": 0.39,
        "level": 2
      },
      {
        "evidence_min": 0.4,
        "evidence_max": 0.59,
        "level": 3
      },
      {
        "evidence_min": 0.6,
        "evidence_max": 0.79,
        "level": 4
      },
      {
        "evidence_min": 0.8,
        "evidence_max": 1.0,
        "level": 5
      }
    ],
    "important_note": "A skill appearing in only one question can only receive level 1 or level 5 from this assessment alone. The backend should label this as assessment evidence rather than a complete real-world skill certification."
  },
  "skill_gap_logic": {
    "formula": "gap = max(target_level - current_level, 0)",
    "gap_labels": [
      {
        "min_gap": 0,
        "max_gap": 0,
        "label": "No Gap"
      },
      {
        "min_gap": 1,
        "max_gap": 1,
        "label": "Low Gap"
      },
      {
        "min_gap": 2,
        "max_gap": 2,
        "label": "Moderate Gap"
      },
      {
        "min_gap": 3,
        "max_gap": 4,
        "label": "High Gap"
      }
    ],
    "priority_rules": [
      {
        "condition": "gap >= 3",
        "priority": "High"
      },
      {
        "condition": "gap == 2",
        "priority": "Medium"
      },
      {
        "condition": "gap == 1",
        "priority": "Low"
      },
      {
        "condition": "gap == 0",
        "priority": "None"
      }
    ],
    "tie_breaker": "If two skills have the same gap, core skills have higher priority than supporting skills."
  },
  "result_generation": {
    "readiness": [
      "readiness_percent",
      "score",
      "max_score",
      "performance_level",
      "validation_label"
    ],
    "strengths": [
      "skills with current_level >= target_level",
      "sort by current_level descending"
    ],
    "weaknesses": [
      "skills with current_level < target_level",
      "sort by gap descending, then core before supporting"
    ],
    "current_skills": [
      "skill_id",
      "skill_name",
      "category",
      "current_level",
      "current_level_label",
      "target_level",
      "evidence_ratio",
      "gap",
      "gap_label",
      "priority"
    ]
  },
